# ============================
# FlowState — Root .gitignore
# ============================

# ---- Java / Maven ----
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/hs_err_pid*
**/.mvn/timing.properties
**/mvnw.cmd

# ---- Node / React (frontend) ----
**/node_modules/
**/build/
**/.pnp
**/.pnp.js
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ---- Environment & Secrets ----
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/application-local.properties
**/application-secret.properties

# ---- IDE & Editor ----
**/.idea/
**/*.iml
**/.vscode/
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db

# ---- OS ----
desktop.ini
.DS_Store
